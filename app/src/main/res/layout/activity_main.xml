<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        android:textSize="56sp"
        android:textColor="@color/text_primary"
        android:gravity="end|bottom"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeMaxTextSize="56sp"
        android:background="@color/bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/gridLayout"
        app:layout_constraintVertical_weight="1"/>

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDisplay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="2">

        <!-- Row 1 -->
        <Button android:id="@+id/btnClear"
            style="@style/BtnSpecial"
            android:text="AC"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btnPlusMinus"
            style="@style/BtnSpecial"
            android:text="+/−"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btnPercent"
            style="@style/BtnSpecial"
            android:text="%"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btnDivide"
            style="@style/BtnOperator"
            android:text="÷"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <!-- Row 2 -->
        <Button android:id="@+id/btn7"
            style="@style/BtnDigit"
            android:text="7"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btn8"
            style="@style/BtnDigit"
            android:text="8"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btn9"
            style="@style/BtnDigit"
            android:text="9"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btnMultiply"
            style="@style/BtnOperator"
            android:text="×"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <!-- Row 3 -->
        <Button android:id="@+id/btn4"
            style="@style/BtnDigit"
            android:text="4"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btn5"
            style="@style/BtnDigit"
            android:text="5"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btn6"
            style="@style/BtnDigit"
            android:text="6"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btnMinus"
            style="@style/BtnOperator"
            android:text="−"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <!-- Row 4 -->
        <Button android:id="@+id/btn1"
            style="@style/BtnDigit"
            android:text="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btn2"
            style="@style/BtnDigit"
            android:text="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btn3"
            style="@style/BtnDigit"
            android:text="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btnPlus"
            style="@style/BtnOperator"
            android:text="+"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <!-- Row 5 -->
        <Button android:id="@+id/btn0"
            style="@style/BtnDigit"
            android:text="0"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_vertical|start"
            android:paddingStart="28dp"/>

        <Button android:id="@+id/btnDot"
            style="@style/BtnDigit"
            android:text="."
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <Button android:id="@+id/btnEquals"
            style="@style/BtnOperator"
            android:text="="
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
