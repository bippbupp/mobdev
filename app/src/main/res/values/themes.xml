<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btn_operator</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="BtnBase">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">5dp</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="BtnDigit" parent="BtnBase">
        <item name="backgroundTint">@color/btn_digit</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BtnSpecial" parent="BtnBase">
        <item name="backgroundTint">@color/btn_special</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BtnOperator" parent="BtnBase">
        <item name="backgroundTint">@color/btn_operator</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

</resources>
